# Gemini Configuration (Required in all modes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Claude Configuration (Optional - enables Production mode when set)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Optional: Force Gemini provider (cost control during development)
# Only accepts "gemini" - used to avoid Claude API costs when a valid Anthropic key exists
# Leave blank for automatic mode detection
AI_FORCE_PROVIDER=

# Logging
LOG_LEVEL=info
