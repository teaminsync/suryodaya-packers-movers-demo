# Gemini Configuration (Required in all modes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Claude Configuration (Optional - enables Production mode when set)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Optional: Force a specific provider (overrides auto-detection)
# Values: "claude" | "gemini" | leave blank for auto-detection
# Use case: Local development cost control
AI_FORCE_PROVIDER=

# Logging
LOG_LEVEL=info
