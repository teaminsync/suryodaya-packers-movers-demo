# Gemini (needed for video; recommended as the fallback for text and images)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Claude (optional): used only when listed in AI_TEXT_CHAIN or AI_IMAGE_CHAIN and the key is valid
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# WhatsApp Configuration
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Ngrok Configuration (for local webhook testing)
NGROK_AUTHTOKEN=

# Server Configuration
PORT=3000

# Database Configuration
DATABASE_URL=

# Supabase Storage Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=move-media

# Logging
LOG_LEVEL=info

# Internal API Secret (for admin dashboard server-to-server auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# Groq (demo text primary; leave empty to disable)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Meta app secret (App Dashboard > App settings > Basic); used to verify webhook signatures
WHATSAPP_APP_SECRET=

# Secret path token for the IndiaMART push endpoint (POST /intake/indiamart/<token>). Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INDIAMART_PUSH_TOKEN=

# Display phone number customers message, digits only (used for click-to-chat links)
WHATSAPP_BUSINESS_NUMBER=

# Instagram Messenger API configuration
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_SECRET=
# Optional second signing secret for rotation
INSTAGRAM_APP_SECRET_ALT=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Default v25.0
INSTAGRAM_API_VERSION=
# Set to "true" to log instead of sending (for testing)
INSTAGRAM_DRY_RUN=

# Groq vision model used for photo analysis (preview model; if you get 404, check console.groq.com/docs/models)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# AI routing (optional). Comma-separated, first is primary, the rest are fallbacks in order. Allowed: groq, gemini, claude.
# Defaults follow the keys you set: text groq,gemini  images gemini,groq  video always gemini. Claude is used only if you list it.
AI_TEXT_CHAIN=
AI_IMAGE_CHAIN=
