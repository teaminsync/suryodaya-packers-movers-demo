# Gemini Configuration (Required in all modes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Claude Configuration (Optional - enables Production mode when set)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Optional: Force Gemini provider (cost control during development)
# Only accepts "gemini" - used to avoid Claude API costs when a valid Anthropic key exists
# Leave blank for automatic mode detection
AI_FORCE_PROVIDER=

# WhatsApp Configuration
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Ngrok Configuration (for local webhook testing)
NGROK_AUTHTOKEN=

# Server Configuration
PORT=3000

# Database Configuration
DATABASE_URL=

# Supabase Storage Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=move-media

# Logging
LOG_LEVEL=info

# Internal API Secret (for admin dashboard server-to-server auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# Groq (optional last-resort fallback; leave empty to disable)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
