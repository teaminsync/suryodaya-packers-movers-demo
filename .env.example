# ---- Server and local tooling ----
# Port for the Express server (default: 3000)
PORT=3000
# Ngrok authentication token (read by the ngrok CLI tool, not by the application)
NGROK_AUTHTOKEN=

# ---- Database and storage ----
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://username:password@host:port/database
# Supabase project URL (required for media uploads)
SUPABASE_URL=https://your-project.supabase.co
# Supabase service role key (required for media uploads)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase storage bucket name (default: move-media)
SUPABASE_STORAGE_BUCKET=move-media

# ---- Internal API ----
# Secret token for internal API endpoints (required)
INTERNAL_API_SECRET=

# ---- WhatsApp ----
# Meta access token for WhatsApp Business API (required)
WHATSAPP_ACCESS_TOKEN=
# WhatsApp phone number ID (required)
WHATSAPP_PHONE_NUMBER_ID=
# Meta Graph API version (default: v21.0)
WHATSAPP_API_VERSION=v21.0
# WhatsApp app secret for webhook signature verification (required)
WHATSAPP_APP_SECRET=
# Webhook verification token (required)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WhatsApp business number in E.164 format, for display purposes (optional)
WHATSAPP_BUSINESS_NUMBER=

# ---- Instagram ----
# Meta access token for Instagram Messaging API (required)
INSTAGRAM_ACCESS_TOKEN=
# Instagram account ID (required)
INSTAGRAM_ACCOUNT_ID=
# Meta Graph API version (default: v25.0)
INSTAGRAM_API_VERSION=v25.0
# Instagram app secret for webhook signature verification (required)
INSTAGRAM_APP_SECRET=
# Alternative app secret for key rotation (optional)
INSTAGRAM_APP_SECRET_ALT=
# Webhook verification token (required)
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Dry-run mode: log messages instead of sending them (default: false)
INSTAGRAM_DRY_RUN=false

# ---- IndiaMART ----
# Push notification authentication token (required for IndiaMART intake endpoint)
INDIAMART_PUSH_TOKEN=

# ---- AI providers ----
# Gemini API key. Needed for video analysis and recommended as the fallback for text and images; text works with only a Groq key.
GEMINI_API_KEY=
# Gemini model (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
# Groq API key (optional; enables Groq text and vision)
GROQ_API_KEY=
# Groq text model (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
# Groq vision model (default: qwen/qwen3.8-27b)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Anthropic API key (optional; enables Claude)
ANTHROPIC_API_KEY=
# Claude model (default: claude-sonnet-5-5)
CLAUDE_MODEL=claude-sonnet-5-5
# Text provider chain as comma-separated names: groq, gemini, claude (optional; auto-selected from available keys)
AI_TEXT_CHAIN=
# Image provider chain as comma-separated names: groq, gemini, claude (optional; auto-selected from available keys)
AI_IMAGE_CHAIN=

# ---- Admin alerts ----
# Resend API key (optional; enables email alerts)
RESEND_API_KEY=
# Admin email address to receive alerts (required if RESEND_API_KEY is set)
ADMIN_EMAIL=
# From address for admin emails (default: Suryodaya Alerts <onboarding@resend.dev>)
ADMIN_EMAIL_FROM=Suryodaya Alerts <onboarding@resend.dev>
# Admin WhatsApp number for alerts in E.164 format (optional; enables WhatsApp alerts)
ADMIN_WHATSAPP_NUMBER=
# WhatsApp message template name for admin alerts (required if ADMIN_WHATSAPP_NUMBER is set)
ADMIN_WHATSAPP_TEMPLATE=
# Dashboard base URL for links in alerts (optional)
DASHBOARD_BASE_URL=
# Dry-run mode for alerts: log instead of sending (default: false)
NOTIFY_DRY_RUN=false

# ---- Conformance testing ----
# Conformance mode (optional, used by src/conformance/run.ts)
CONFORMANCE_ONLY=
# Conformance provider override (optional, used by src/conformance/run.ts)
CONFORMANCE_PROVIDER=

# RUN_LIVE_TESTS is set by the npm run test:live:* scripts. Do not put it in .env.

# ---- Survey scheduling and Google Calendar (all optional; without GOOGLE_CALENDAR_ID the assistant offers fixed example times) ----
# Calendar that holds survey bookings. Share it with the service account email ("Make changes to events").
GOOGLE_CALENDAR_ID=
# Path to the service account JSON key file. Keep the file OUTSIDE the project folder (the .gitignore also blocks common key file names).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Alternative for hosting: the whole key JSON, raw or base64-encoded. Used only when no key file path is set.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The values below are the defaults. All times are India time (IST).
SURVEY_WORKDAYS=mon,tue,wed,thu,fri,sat
SURVEY_WORK_START=10:00
SURVEY_WORK_END=18:00
# Lunch break with no surveys; set both to none to disable
SURVEY_BREAK_START=13:00
SURVEY_BREAK_END=14:00
SURVEY_DURATION_MINUTES=60
# Travel buffer kept free on each side of an existing booking
SURVEY_BUFFER_MINUTES=30
SURVEY_SLOT_STEP_MINUTES=60
# How many surveys may overlap (number of surveyors)
SURVEY_CONCURRENCY=1
SURVEY_MIN_NOTICE_HOURS=6
SURVEY_MAX_DAYS_AHEAD=14
# Comma-separated dates (YYYY-MM-DD) with no surveys. A timed Busy event in the calendar also blocks that time.
SURVEY_HOLIDAYS=


# ---- Automated follow-ups ----
# Enable automated follow-up messages for WhatsApp leads (default: false)
FOLLOWUPS_ENABLED=false
# Dry-run mode: log actions instead of sending messages (default: false)
FOLLOWUPS_DRY_RUN=false
# Scheduler tick interval in minutes (default: 5)
FOLLOWUPS_TICK_MINUTES=5
# Maximum follow-ups to send per day (default: 20)
FOLLOWUPS_DAILY_CAP=20
# Start of sending hours in IST (default: 9)
FOLLOWUPS_SEND_FROM_HOUR=9
# End of sending hours in IST (default: 20)
FOLLOWUPS_SEND_UNTIL_HOUR=20
# Hours after last inbound to send check-in message while window is open (default: 22)
FOLLOWUPS_NUDGE_INWINDOW_HOURS=22
# Hours after last inbound to send template message after window closes (default: 48)
FOLLOWUPS_NUDGE_TEMPLATE_HOURS=48
# Hours after last inbound to prompt for missing details (default: 3)
FOLLOWUPS_MISSING_DETAILS_HOURS=3
# Hours before survey to send reminder (default: 24)
FOLLOWUPS_REMINDER_HOURS_BEFORE=24
# Hours before survey to send late reminder if booking confirmed late (default: 3)
FOLLOWUPS_REMINDER_LATE_HOURS=3
# Maximum nudge messages per lead (default: 2)
FOLLOWUPS_MAX_NUDGES=2
